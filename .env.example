# ABOUTME: Runtime settings template. Copy to C:\Repos\.config\coding-agent\runtime.env, outside the repository;
# ABOUTME: set-nas-secrets.ps1 sends it to the NAS. Never commit real values.
ANTHROPIC_API_KEY=replace-with-an-anthropic-api-key
# GitHub App for the driver's Git calls on product repositories (Contents read/write, installed on product repos only).
# Each call gets a one-hour token for its one repository: write only to push, read otherwise.
CODING_AGENT_GITHUB_APP_ID=replace-with-the-numeric-app-id
CODING_AGENT_GITHUB_APP_INSTALLATION_ID=replace-with-the-numeric-installation-id
# Path to the app's .pem private key on this PC. set-nas-secrets.ps1 sends the file itself to the NAS.
CODING_AGENT_GITHUB_APP_PRIVATE_KEY_FILE=replace-with-the-path-to-the-private-key.pem
# Fine-grained token, Contents read-only, on the intent repositories only. The app is not installed there.
CODING_AGENT_INTENT_TOKEN=replace-with-a-read-only-github-token
# Shared bearer token the Conductor sends.
CODING_AGENT_API_TOKEN=replace-with-a-long-random-token
CODING_AGENT_GIT_NAME=coding-agent
CODING_AGENT_GIT_EMAIL=coding-agent@users.noreply.github.com
# Optional overrides (defaults shown).
# CODING_AGENT_MODEL=claude-opus-5-5
# CODING_AGENT_EFFORT=high
# CODING_AGENT_MAX_TURNS=60
# CODING_AGENT_MAX_COST_USD=5
# CODING_AGENT_MAX_RUNTIME_MIN=30
