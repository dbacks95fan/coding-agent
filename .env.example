# ABOUTME: Runtime settings template. Copy to the NAS secrets file; never commit real values.
ANTHROPIC_API_KEY=replace-with-an-anthropic-api-key
# Fine-grained GitHub token: contents read/write on the product repository, read on intent-backlog.
CODING_AGENT_GIT_TOKEN=replace-with-a-github-token
# Shared bearer token the Conductor sends.
CODING_AGENT_API_TOKEN=replace-with-a-long-random-token
CODING_AGENT_GIT_NAME=coding-agent
CODING_AGENT_GIT_EMAIL=coding-agent@users.noreply.github.com
# Optional overrides (defaults shown).
# CODING_AGENT_MODEL=claude-opus-5-5
# CODING_AGENT_EFFORT=high
# CODING_AGENT_MAX_TURNS=60
# CODING_AGENT_MAX_COST_USD=5
# CODING_AGENT_MAX_RUNTIME_MIN=30
